{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aihub",
  "version": "0.3.0",
  "identifier": "io.github.openx123.aihub",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "Copyright © 2026",
    "category": "Productivity",
    "shortDescription": "AI 聊天站点聚合窗口",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRTI5MEExQzIwMUJCMzAKUldRd3V3SENvWkRpVC9LZy9vb2IvMWgreFJicnJqME94elFtc3FDNWZyc3BrYXpFZHBIK2d4eUsK",
      "endpoints": [
        "https://github.com/OpenX123/aihub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}